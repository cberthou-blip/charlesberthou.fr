rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Reads the caller's own doc to verify admin status.
    // exists() guard avoids errors on first sign-up (no doc yet).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Returns true when the update does NOT touch isAdmin or approved.
    function notChangingProtectedFields() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['isAdmin', 'approved']);
    }

    // ─── /users/{userId} ──────────────────────────────────────────────────────

    match /users/{userId} {

      // READ: any signed-in user can read any user document.
      // Needed for leaderboard, challenge opponent list, team member lookup.
      allow read: if isSignedIn();

      // CREATE: own document only; isAdmin and approved must be absent or false.
      allow create: if isSignedIn() && isOwner(userId)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('approved' in request.resource.data) || request.resource.data.approved == false);

      // UPDATE: own doc (cannot change isAdmin / approved) OR admin (unrestricted).
      allow update: if isSignedIn() && (
        (isOwner(userId) && notChangingProtectedFields())
        || isAdmin()
      );

      // DELETE: admin only.
      allow delete: if isAdmin();
    }

    // ─── /challenges/{docId} ──────────────────────────────────────────────────

    match /challenges/{docId} {
      // Any signed-in user can read challenges.
      // (Client queries already filter by fromUid / recipient name.)
      allow read: if isSignedIn();

      // Create: sender must identify themselves as fromUid.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;

      // Update / delete: any authenticated user.
      // Participants update status/scores after a duel; either side can archive.
      allow update, delete: if isSignedIn();
    }

    // ─── /teams/{teamId} ──────────────────────────────────────────────────────

    match /teams/{teamId} {
      allow read: if isSignedIn();

      // Members can create a team where they are the first (and only) member.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.captainUid == request.auth.uid;

      // Members or admin can update a team they belong to.
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.members.hasAny([request.auth.uid])
        || request.resource.data.members.hasAny([request.auth.uid])
      );

      // Only captain or admin can delete a team.
      allow delete: if isSignedIn() && (
        isAdmin()
        || resource.data.captainUid == request.auth.uid
      );
    }

    // ─── /settings/{docId} ────────────────────────────────────────────────────

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Catch-all: deny everything else ──────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
